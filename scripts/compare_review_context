#!/usr/bin/env python3
"""Opt-in paired review benchmark; never sends transcripts or previous verdicts."""
import argparse
import json
from pathlib import Path
import subprocess
from factorylib.harness import review_json, run
from factorylib.protocol import atomic_json, capsule, load_policy, load_task, read_json

p = argparse.ArgumentParser()
p.add_argument("--root", required=True)
p.add_argument("--task", required=True)
p.add_argument("--output", required=True)
a = p.parse_args()
control = Path(a.root).resolve()
receipt = read_json(control / ".factory-runtime" / f"{a.task}.json")
root = Path(receipt["worktree"])
task, policy = load_task(control, a.task), load_policy(control)
bounded = capsule(root, task, policy, review=True, base=receipt["base"], evidence=receipt["evidence"])
files = subprocess.run(["git", "ls-files", "-z"], cwd=root, capture_output=True, check=True).stdout.split(b"\0")
extra = []
for raw in files:
    if not raw:
        continue
    name = raw.decode()
    # Baseline includes unrelated source/docs/tasks/tools; exclude prior verdicts,
    # checkpoints, credentials, raw events and runtime state from independent review.
    if name.startswith((".project/state/", ".project/checkpoints/", ".factory-runtime/")):
        continue
    path = root / name
    if path.is_file() and not path.is_symlink():
        try:
            extra.append(f"\nRepository file: {name}\n{path.read_text()}")
        except UnicodeDecodeError:
            pass
naive = bounded["text"] + "\nFull repository context baseline:\n" + "\n".join(extra)
if len(naive.encode()) > 100000:
    raise SystemExit("baseline exceeds explicit 100KB benchmark safety cap")
results = []
for label, prompt in (("bounded_with_relevant_artifacts", bounded["text"]), ("naive_repository_dump", naive)):
    result = run(root, {"harness": "codex"}, prompt, "review", 120)
    verdict = review_json(result["final"]) if result["passed"] else None
    results.append({"condition": label, "run_id": result["run_id"], "passed": result["passed"],
                    "context_bytes": result["context_bytes"], "usage": result["usage"],
                    "duration_seconds": result["duration_seconds"], "verdict": verdict})
report = {"task": a.task, "target": receipt["evidence"]["sha"], "conditions": results,
          "limits": "One paired read-only review, same configured Codex default; cache/order and random variation are uncontrolled. No general reliability/cost claim."}
atomic_json(Path(a.output), report)
print(json.dumps(report, indent=2))
